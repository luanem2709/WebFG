DATABASE_URL="file:./dev.db"

# Site config
SITE_NAME="funnygame"
SITE_TITLE="funnygame - Gói sử dụng dịch vụ"
PRIMARY_COLOR="#ff6b6b"
CONTACT_EMAIL="support@funnygame.vn"
CONTACT_PHONE="0900 123 456"
CONTACT_ADDRESS="123 Đường ABC, Quận 1, TP. Hồ Chí Minh"

# Payment gateway: mock | sepay | casso
PAYMENT_GATEWAY="mock"

# SePay
SEPAY_API_KEY=""
SEPAY_SECRET=""
SEPAY_MERCHANT_ID=""

# Casso
CASSO_API_KEY=""
CASSO_SECRET=""
CASSO_MERCHANT_ID=""

# VietQR
VIETQR_BIN="970418"
VIETQR_ACCOUNT="1234567890"
VIETQR_ACCOUNT_NAME="FUNNYGAME"
VIETQR_TEMPLATE="compact"

# Email (SMTP)
EMAIL_FROM="noreply@funnygame.vn"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_DEV_LOG=true

# Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin123!"
ADMIN_SESSION_SECRET="change-me-in-production-32-chars-min"

# Business rules
EXPIRY_REMIND_DAYS=3
ORDER_HOLD_MINUTES=15
SANDBOX=true

# App
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"


# B?o v? endpoint cron (g?i header Authorization: Bearer <secret>)
CRON_SECRET=""

# ---- Google Sheet KeyFG (dùng sheet có sẵn) ----
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_LICENSE_TAB="LicenseKeys"
# JSON của Service Account, viết trên MỘT dòng (hoặc dùng GOOGLE_SERVICE_ACCOUNT_B64 = base64 của file JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=""
# GENERATE = tự sinh key mới rồi append | STOCK = lấy key chưa bán có sẵn trong sheet
KEY_MODE="GENERATE"
# Trạng thái ghi cho key mới (kiểm tra với ứng dụng đọc sheet!)
SHEET_NEW_STATUS="unused"
SHEET_TIMEZONE="Asia/Ho_Chi_Minh"

# ---- Thông báo cho admin ----
ADMIN_ALERT_EMAIL=""
# Telegram (tùy chọn): bỏ trống thì bỏ qua
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Thu hồi key trên sheet: MANUAL (chỉ liệt kê cho admin xử lý tay) | OFF. Web không bao giờ tự sửa dòng cũ.
REVOKE_MODE="MANUAL"

